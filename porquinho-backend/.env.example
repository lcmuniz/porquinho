# Database Configuration (Supabase PostgreSQL)
# Get these values from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/database
SUPABASE_DB_URL=jdbc:postgresql://aws-1-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_USERNAME=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# JWT Configuration (Supabase Auth)
# Get these values from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_JWT_ISSUER_URI=https://your-project-ref.supabase.co/auth/v1

# Redis Configuration (Optional for local development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Stripe (Story 2.2 - assinatura mensal). Chaves de TESTE: https://dashboard.stripe.com/test/apikeys
# Nunca coloque chaves Stripe no .env do frontend.
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Local: `stripe listen --events checkout.session.completed,customer.subscription.deleted,invoice.paid,invoice.payment_failed --forward-to localhost:8080/api/v1/webhooks/stripe` imprime o whsec_...
# Falhas de pagamento (Story 2.7): quem repete a cobrança é o Stripe. Configure no Dashboard (test e live):
#   Billing -> Revenue recovery -> Retries: agendamento customizado com 2 novas tentativas, 3 e 10 dias
#   depois da falha; "If all retries for a payment fail" -> cancel the subscription
#   (o customer.subscription.deleted resultante deixa a assinatura SUSPENDED).
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# URL do frontend para os retornos do Checkout (/assinatura?status=...)
FRONTEND_URL=http://localhost:5173

# E-mail transacional (Resend via SMTP). Sem SMTP_HOST os envios são ignorados (best-effort).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your-api-key
MAIL_FROM=porquinho <nao-responda@porquinho.eficaztech.cloud>
